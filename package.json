{
  "name": "@cycjimmy/sass-lib",
  "type": "module",
  "version": "4.0.0",
  "description": "Personal collection of sass.",
  "sass": "index.scss",
  "author": "cycjimmy <cycjimmy@gmail.com> (https://github.com/cycjimmy)",
  "license": "MIT",
  "homepage": "https://github.com/cycjimmy/sass-lib#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cycjimmy/sass-lib.git"
  },
  "bugs": {
    "url": "https://github.com/cycjimmy/sass-lib/issues"
  },
  "keywords": [
    "collection",
    "sass"
  ],
  "exports": {
    ".": {
      "sass": "./index.scss",
      "default": "./index.scss"
    },
    "./*": "./*"
  },
  "main": "index.scss",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:style": "stylelint \"*.scss\" \"functions/**/*.scss\" \"mixins/**/*.scss\" \"placeholders/**/*.scss\" \"reset/**/*.scss\" \"test/**/*.scss\"",
    "lint:style:fix": "stylelint \"*.scss\" \"functions/**/*.scss\" \"mixins/**/*.scss\" \"placeholders/**/*.scss\" \"reset/**/*.scss\" \"test/**/*.scss\" --fix",
    "test": "sass --no-source-map --fatal-deprecation=1.80.0 test/index.scss",
    "build": "trash .release && node tasks/copyFiles.js && node tasks/handlePackageJson.js",
    "package": "npm run build"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cycjimmy/config-lib": "^3.2.2",
    "eslint": "^10.13.0",
    "fs-extra": "^11.4.1",
    "sass": "^1.106.0",
    "stylelint": "^17.16.0",
    "stylelint-config-idiomatic-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "trash-cli": "^7.2.0"
  }
}
